{"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"Macro assertions capture the literal source text of expressions for use in","type":"text"},{"text":" ","type":"text"},{"text":"failure output. For boolean macro assertions, compound expressions using ","type":"text"},{"type":"codeVoice","code":"&&"},{"type":"text","text":""},{"type":"text","text":" "},{"text":"and ","type":"text"},{"code":"||","type":"codeVoice"},{"type":"text","text":" are decomposed to show the value of each sub-expression and identify"},{"text":" ","type":"text"},{"type":"text","text":"which caused the assertion failure, respecting short-circuit evaluation so only"},{"type":"text","text":" "},{"type":"text","text":"evaluated operands appear in the output. Other macro assertions capture the"},{"text":" ","type":"text"},{"type":"text","text":"expression text without decomposition."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Macro assertions are particularly useful when testing complex expressions or","type":"text"},{"text":" ","type":"text"},{"text":"reviewing CI\/CD logs without immediate access to the source code.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swifttestkit\/macroassertions"]}],"kind":"article","seeAlsoSections":[{"title":"Articles","generated":true,"identifiers":["doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/Configuration","doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/CustomDiffs","doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/FunctionAssertions","doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/AtomicTesting","doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/PerformanceTesting","doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/TemporalTesting","doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/PropertyBasedTesting"],"anchor":"Articles"}],"identifier":{"url":"doc:\/\/SwiftTestKit\