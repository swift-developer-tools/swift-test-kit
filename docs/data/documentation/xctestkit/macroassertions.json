{"sections":[],"variants":[{"paths":["\/documentation\/xctestkit\/macroassertions"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"Macro assertions capture the literal source text of expressions for use in","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"failure output. For boolean macro assertions, compound expressions using "},{"code":"&&","type":"codeVoice"},{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"||","type":"codeVoice"},{"text":" are decomposed to show the value of each sub-expression and identify","type":"text"},{"text":" ","type":"text"},{"text":"which caused the assertion failure, respecting short-circuit evaluation so only","type":"text"},{"text":" ","type":"text"},{"text":"evaluated operands appear in the output. Other macro assertions capture the","type":"text"},{"text":" ","type":"text"},{"text":"expression text without decomposition.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Macro assertions are particularly useful when testing complex expressions or"},{"type":"text","text":" "},{"type":"text","text":"reviewing CI\/CD logs without immediate access to the source code."}]}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/XCTestKit\/documentation\/XCTestKit\/Configuration","doc:\/\/XCTestKit\/documentation\/XCTestKit\/CustomDiffs","doc:\/\/XCTestKit\/documentation\/XCTestKit\/FunctionAssertions","doc:\/\/XCTestKit\/documentation\/XCTestKit\/AtomicTesting","doc:\/\/XCTestKit\/documentation\/XCTestKit\/PerformanceTesting","doc:\/\/XCTestKit\/documentation\/XCTestKit\/TemporalTesting","doc:\/\/XCTestKit\/documentation\/XCTestKit\/PropertyBasedTesting"],"title":"Articles","generated":true,"anchor":"Articles"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/XCTestKit\