{"abstract":[{"type":"text","text":"Synthesizes partial "},{"identifier":"doc:\/\/XCTestKit\/documentation\/XCTestKit\/Stateful","type":"reference","isActive":true},{"type":"text","text":" conformance for enums."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@attached","kind":"attribute"},{"text":"(extension, conformances: ","kind":"text"},{"identifier":"doc:\/\/XCTestKit\/documentation\/XCTestKit\/Stateful","preciseIdentifier":"s:9XCTestKit8Statefula","text":"Stateful","kind":"typeIdentifier"},{"text":", names: named(arbitrary), named(shrink)) ","kind":"text"},{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Stateful","kind":"identifier"},{"text":"()","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply the "},{"type":"codeVoice","code":"@Stateful"},{"type":"text","text":" macro to an enum to automatically synthesize partial"},{"type":"text","text":" "},{"identifier":"doc:\/\/XCTestKit\/documentation\/XCTestKit\/Stateful","type":"reference","isActive":true},{"type":"text","text":" conformance."}]},{"type":"codeListing","code":["@Stateful","enum CacheCommand","{","    typealias System    = Cache<String, Int>","    typealias Model     = Int","","    case insert(key: String, value: Int)","    case lookup(key: String)","    case delete(key: String)","    case clear","","    \/\/ Generated by the macro automatically:","    \/\/ - arbitrary(using:model:)","    \/\/ - shrink()","","    \/\/ Must be added manually:","    \/\/ - run(model:system:)","    \/\/ - advance(model:)","","    \/\/ May be added manually:","    \/\/ - precondition(model:)","    \/\/ - postcondition(model:system:)","    \/\/ - shrink(model:)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Type aliases for 