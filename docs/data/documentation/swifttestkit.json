{"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/swifttestkit"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"identifiers":["doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/Configuration","doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/CustomDiffs","doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/FunctionAssertions","doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/MacroAssertions","doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/AtomicTesting","doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/PerformanceTesting","doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/TemporalTesting","doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/PropertyBasedTesting"],"anchor":"Articles","title":"Articles"}],"metadata":{"title":"SwiftTestKit","symbolKind":"module","modules":[{"name":"SwiftTestKit"}],"externalID":"SwiftTestKit","roleHeading":"Framework","role":"collection"},"hierarchy":{"paths":[[]]},"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"SwiftTestKit extends the ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/xcode\/swift-testing","isActive":true,"type":"reference"},{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"framework with composable test evaluators, advanced assertions, structural","type":"text"},{"text":" ","type":"text"},{"text":"diffs, and expression capture.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"When assertions fail, structural diffs pinpoint exactly where values diverge","type":"text"},{"text":" ","type":"text"},{"text":"within complex data structures, using path-based output that scales from flat","type":"text"},{"text":" ","type":"text"},{"text":"primitives to deeply-nested structs, collections, and multi-line strings.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Macro assertions capture the literal source text of expressions and decompose","type":"text"},{"text":" ","type":"text"},{"text":"compound boolean logic to identify which sub-expression caused the failure.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Predicate assertions verify conditions across collection elements and produce","type":"text"},{"text":" ","type":"text"},{"text":"element-level failure output, identifying which elements failed, which matched","type":"text"},{"text":" ","type":"text"},{"text":"unexpectedly, and which threw errors.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Atomic tests group assertions into a single atomic evaluation and verify that","type":"text"},{"text":" ","type":"text"},{"text":"all assertions pass within a single execution.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Performance tests measure execution time and physical memory footprint across","type":"text"},{"text":" ","type":"text"},{"text":"multiple runs, and verify that median values stay within configurable limits.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Temporal tests poll assertions continuously for a given duration, or until all","type":"text"},{"text":" ","type":"text"},{"text":"assertions pass within a single execution.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Property-based testing generates random values automatically and shrinks","type":"text"},{"text":" ","type":"text"},{"text":"failures to minimal counterexamples. Targeted testing guides generation toward","type":"text"},{"text":" ","type":"text"},{"text":"inputs that maximize a numeric value. Stateful testing extends property-based","type":"text"},{"text":" ","type":"text"},{"text":"testing to systems with mutable state, generating random command sequences and","type":"text"},{"text":" ","type":"text"},{"text":"verifying the system against a simplified model.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"All APIs accept options for configuring diffs, formatting, timeouts, and other","type":"text"},{"text":" ","type":"text"},{"text":"test behavior. Options can be configured globally, per-scope, or per-call.","type":"text"}]},{"content":[{"inlineContent":[{"text":"Property-based tests, stateful tests, temporal tests, performance tests,","type":"text"},{"text":" ","type":"text"},{"text":"and atomic tests compose freely. Any evaluator may be nested inside any","type":"text"},{"text":" ","type":"text"},{"text":"other evaluator, and all evaluators can wrap standalone assertions. Any","type":"text"},{"text":" ","type":"text"},{"text":"failures propagate with the same rich output used by standalone assertions.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"tip","name":"Tip"},{"content":[{"inlineContent":[{"text":"To test with the","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/xctest","type":"reference","isActive":true},{"text":" framework, use","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/swift-developer-tools.github.io\/swift-test-kit\/documentation\/xctestkit","type":"reference","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"SwiftTestKit and XCTestKit provide identical APIs.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"},{"text":"Structural Diffs","anchor":"Structural-Diffs","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Assertion failures produce path-based diff output providing clear insight into","type":"text"},{"text":" ","type":"text"},{"text":"where values differ within complex data structures.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Below are examples of diff output for several common data types.","type":"text"}]},{"text":"Nested Structs","anchor":"Nested-Structs","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["struct Inner: Equatable","{","    let id      : Int","    let value   : Int","    let label   : String","}","","struct Outer: Equatable","{","    let tag     : String","    let inner   : Inner","}","","let expected    = Outer(tag: \"a\", inner: Inner(id: 1, value: 100, label: \"b\"))","let actual      = Outer(tag: \"a\", inner: Inner(id: 1, value: 200, label: \"b\"))","","STKAssertEqual(expected, actual)","","\/\/ STKAssertEqual failed","\/\/","\/\/ Outer differs at:","\/\/","\/\/     .inner.value","\/\/         Expected:   100","\/\/         Actual:     200"]},{"text":"Arrays","anchor":"Arrays","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["let expected    = [1, 2, 3, 4, 5, 6, 7, 8]","let actual      = [0, 0, 3, 4, 5, 6, 7, 0]","","let options = TestOptions(formatOptions: .init(maxDiffs: 2))","","STKAssertEqual(expected, actual, options: options)","","\/\/ STKAssertEqual failed","\/\/","\/\/ Array<Int> differs at:","\/\/","\/\/     [0]","\/\/         Expected:   1","\/\/         Actual:     0","\/\/","\/\/     [1]","\/\/         Expected:   2","\/\/         Actual:     0","\/\/","\/\/     ... and 1 more difference"]},{"text":"Multi-Line Strings","anchor":"Multi-Line-Strings","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["let expected    = \"Line 1\\nLine 2\\nLine 3\"","let actual      = \"Line 1\\nLine X\\nLine 3\"","","STKAssertEqual(expected, actual)","","\/\/ STKAssertEqual failed","\/\/","\/\/ String differs at:","\/\/","\/\/     line 2","\/\/         Expected:   \"Line 2\"","\/\/         Actual:     \"Line X\"","\/\/         Changed:    character 6 (\"2\" → \"X\")"]},{"text":"Sets","anchor":"Sets","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["let expected    : Set<String>   = [\"a\", \"b\", \"c\"]","let actual      : Set<String>   = [\"a\", \"e\", \"f\"]","","STKAssertEqual(expected, actual)","","\/\/ STKAssertEqual failed","\/\/","\/\/ Set<String> differs:","\/\/","\/\/     Missing:    \"b\"","\/\/     Missing:    \"c\"","\/\/     Unexpected: \"e\"","\/\/     Unexpected: \"f\""]},{"text":"Custom Diffs","anchor":"Custom-Diffs","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Types that conform to ","type":"text"},{"identifier":"doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/CustomDiffRepresentable","type":"reference","isActive":true},{"type":"text","text":" can control which properties"},{"text":" ","type":"text"},{"type":"text","text":"are recursed into when computing diffs. This is useful for excluding properties"},{"type":"text","text":" "},{"type":"text","text":"that are irrelevant to logical equality, such as timestamps and large data"},{"type":"text","text":" "},{"text":"blobs that would produce noisy output.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Types that conform to "},{"type":"reference","identifier":"doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/CustomDiffStringConvertible","isActive":true},{"type":"text","text":" can control how a value"},{"type":"text","text":" "},{"type":"text","text":"appears in structural diffs. This is useful for types with verbose or unclear"},{"type":"text","text":" "},{"type":"text","text":"default string representation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both protocols may be adopted independently."}]},{"text":"Expression Capture","anchor":"Expression-Capture","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Macro assertions capture the literal source text of expressions for use in"},{"type":"text","text":" "},{"type":"text","text":"failure output. For boolean macro assertions, compound expressions using "},{"type":"codeVoice","code":"&&"},{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"||","type":"codeVoice"},{"type":"text","text":" are decomposed to show the value of each sub-expression and identify"},{"type":"text","text":" "},{"type":"text","text":"which caused the assertion failure, respecting short-circuit evaluation so only"},{"type":"text","text":" "},{"type":"text","text":"evaluated operands appear in the output. Other macro assertions capture the"},{"type":"text","text":" "},{"type":"text","text":"expression text without decomposition."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Below are examples of expression capture output for several common scenarios."}]},{"anchor":"Boolean-Decomposition","type":"heading","text":"Boolean Decomposition","level":3},{"syntax":"swift","code":["#STKAssertTrue(isValid() && hasAccess && count >= 10)","\/\/ where isValid() -> true, hasAccess == false, count == 20","","\/\/ #STKAssertTrue failed","\/\/ ","\/\/ Expression: isValid() && hasAccess && count >= 10","\/\/ ","\/\/     isValid() = true","\/\/     hasAccess = false ←","\/\/ ","\/\/     (1 expression not evaluated)"],"type":"codeListing"},{"text":"Nested Expressions","anchor":"Nested-Expressions","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["#STKAssertFalse((a || b) && (c || d))","\/\/ where a == true, b == false, c == true, d == false","","\/\/ #STKAssertFalse failed","\/\/ ","\/\/ Expression: (a || b) && (c || d)","\/\/ ","\/\/     a = true ←","\/\/     c = true ←","\/\/ ","\/\/     (2 expressions not evaluated)"]},{"anchor":"Non-Boolean-Assertions","type":"heading","text":"Non-Boolean Assertions","level":3},{"syntax":"swift","code":["#STKAssertNoThrow(try getValue())","","\/\/ #STKAssertNoThrow failed","\/\/ ","\/\/ Expression: try getValue()","\/\/ Threw:      RequestError.timeout"],"type":"codeListing"},{"syntax":"swift","code":["#STKAssertNil(result.error)","\/\/ where result.error == RequestError.timeout","","\/\/ #STKAssertNil failed","\/\/ ","\/\/ Expression: result.error","\/\/ Actual:     RequestError.timeout"],"type":"codeListing"},{"level":2,"anchor":"Predicate-Assertions","text":"Predicate Assertions","type":"heading"},{"inlineContent":[{"type":"text","text":"Predicate assertions verify conditions across collection elements and produce"},{"type":"text","text":" "},{"type":"text","text":"element-level failure output, identifying which elements failed, which were"},{"type":"text","text":" "},{"type":"text","text":"matched unexpectedly, and which threw errors."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Below are examples of predicate assertion output for several common scenarios."}],"type":"paragraph"},{"level":3,"anchor":"All-Satisfy","text":"All Satisfy","type":"heading"},{"syntax":"swift","code":["STKAssertAllSatisfy([10, 15, 20, 25]) { $0.isMultiple(of: 10) }","","\/\/ STKAssertAllSatisfy failed","\/\/ ","\/\/ Collection count: 4","\/\/ ","\/\/ Failed: 2 of 4","\/\/ ","\/\/     [1]: 15","\/\/     [3]: 25"],"type":"codeListing"},{"level":3,"type":"heading","text":"Exactly","anchor":"Exactly"},{"code":["#STKAssertExactly([30, 25, 10, 35, 15], count: 2) { $0 > 20 }","","\/\/ #STKAssertExactly failed","\/\/ ","\/\/ Collection count: 5","\/\/ ","\/\/ Collection: [30, 25, 10, 35, 15]","\/\/ Predicate:  { $0 > 20 }","\/\/ ","\/\/ Expected: exactly 2 matches","\/\/ Actual:   3 matched","\/\/ ","\/\/     Matched: [0-1], [3]"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Sorted","text":"Sorted","type":"heading"},{"type":"codeListing","syntax":"swift","code":["STKAssertSorted([10, 30, 20, 40], by: <)","","\/\/ STKAssertSorted failed","\/\/ ","\/\/ Collection count: 4","\/\/ ","\/\/ Not sorted at:","\/\/ ","\/\/     [1]: 30","\/\/     [2]: 20"]},{"type":"heading","text":"Unique","level":3,"anchor":"Unique"},{"type":"codeListing","syntax":"swift","code":["STKAssertUnique([\"aa\", \"bb\", \"c\"], by: { $0.count })","","\/\/ STKAssertUnique failed","\/\/ ","\/\/ Collection count: 3","\/\/ ","\/\/ Duplicates: 1 key","\/\/ ","\/\/     Key 2:","\/\/         [0]: \"aa\"","\/\/         [1]: \"bb\""]},{"type":"heading","text":"Error Handling","level":3,"anchor":"Error-Handling"},{"type":"codeListing","syntax":"swift","code":["enum NumberError: Error { case invalid }","","let values: [Int] = [20, -10, 40, -30, 60]","","STKAssertSatisfy(values, atLeast: 4)","{","    value in","","    guard value >= 0 else { throw NumberError.invalid }","    return value.isMultiple(of: 20)","}","","\/\/ STKAssertSatisfy failed","\/\/ ","\/\/ Collection count: 5","\/\/ ","\/\/ Expected: at least 4 matches","\/\/ Actual:   3 matched, 2 threw errors","\/\/ ","\/\/     Matched: [0], [2], [4]","\/\/ ","\/\/     Threw errors:","\/\/         [1]: -10 (threw error \"invalid\")","\/\/         [3]: -30 (threw error \"invalid\")"]},{"level":2,"anchor":"Atomic-Testing","text":"Atomic Testing","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Atomic tests group assertions into a single atomic evaluation and verify that","type":"text"},{"text":" ","type":"text"},{"text":"all assertions pass within a single execution.","type":"text"}]},{"type":"codeListing","code":["await STKAtomic","{","    let result = try await DataService.process(\"raw-data\")","    ","    STKAssertGreaterThan(result.iterations, 0)","    STKAssertNotNil(result.output)","    STKAssertEqual(.completed, result.state)","}","","\/\/ STKAtomic failed (2 failed assertions)","\/\/ ","\/\/ Failure 1:","\/\/     STKAssertNotNil failed","\/\/ ","\/\/ Failure 2:","\/\/     STKAssertEqual failed","\/\/     ","\/\/     Expected:   completed","\/\/     Actual:     failed"],"syntax":"swift"},{"level":2,"anchor":"Performance-Testing","text":"Performance Testing","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Performance tests measure execution time and physical memory footprint across","type":"text"},{"type":"text","text":" "},{"type":"text","text":"multiple runs, and verify that median values stay within configurable limits."}]},{"type":"heading","text":"Time","anchor":"Time","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify the execution time:"}]},{"syntax":"swift","code":["\/\/ Assert that a custom sort function is working correctly,","\/\/ and that it sorts within 50 milliseconds.","await STKPerformance(timeLimit: .milliseconds(50))","{","    STKAssertSorted(customSort(array), by: >=)","}","","\/\/ STKPerformance failed","\/\/ ","\/\/ Time:","\/\/     Threshold: 50 ms","\/\/     Median:    77 ms (10 runs) ←"],"type":"codeListing"},{"type":"heading","text":"Memory","anchor":"Memory","level":3},{"type":"paragraph","inlineContent":[{"text":"Verify the physical memory footprint:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Assert that a tokenizer's memory footprint is less than 5 MB.","await STKPerformance(memoryLimit: .megabytes(4.5))","{","    _ = try await tokenize(source)","}","","\/\/ STKPerformance failed","\/\/ ","\/\/ Memory:","\/\/     Threshold: 4.5 MB","\/\/     Median:    9.5 MB (10 runs) ←"]},{"type":"heading","text":"Temporal Testing","anchor":"Temporal-Testing","level":2},{"inlineContent":[{"type":"text","text":"Temporal tests poll assertions over a configurable duration to verify"},{"type":"text","text":" "},{"type":"text","text":"continuous invariants or eventual convergence."}],"type":"paragraph"},{"type":"heading","text":"Eventually","anchor":"Eventually","level":3},{"inlineContent":[{"type":"text","text":"Verify an eventual outcome:"}],"type":"paragraph"},{"syntax":"swift","code":["let service = DataService()","service.startLoading()","","\/\/ Assert that the service eventually loads.","await STKEventually(timeout: .seconds(2))","{","    STKAssertEqual(.loaded, service.state)","}","","\/\/ STKEventually failed after 2 sec","\/\/ ","\/\/ STKAssertEqual failed","\/\/ ","\/\/ Expected:   loaded","\/\/ Actual:     processing"],"type":"codeListing"},{"level":3,"text":"Always","anchor":"Always","type":"heading"},{"inlineContent":[{"text":"Verify a continuous invariant:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let buffer = Buffer(capacity: 10)","buffer.startProducing()","","\/\/ Assert that the buffer never exceeds capacity.","await STKAlways(interval: .milliseconds(10))","{","    STKAssertLessThanOrEqual(buffer.count, buffer.capacity)","}","","\/\/ STKAlways failed after 77.7 ms","\/\/ ","\/\/ STKAssertLessThanOrEqual failed: (\"12\") is not less than or equal to (\"10\")"],"type":"codeListing"},{"level":2,"text":"Property-Based Testing","anchor":"Property-Based-Testing","type":"heading"},{"inlineContent":[{"text":"Describe properties that must hold for any given value, and SwiftTestKit will","type":"text"},{"text":" ","type":"text"},{"text":"generate random test cases automatically.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["STKForAll","{","    (a: Int, b: Int) in","    ","    \/\/ Addition is commutative. The assertion passes for all values.","    STKAssertEqual(a + b, b + a)","}"],"type":"codeListing"},{"inlineContent":[{"text":"Asynchronous and throwing tests are also supported.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["await STKForAll","{","    (value: String) async throws in","    ","    try await db.save(value, forKey: \"test\")","    let loaded: String? = try await db.load(forKey: \"test\")","    ","    STKAssertEqual(loaded, value)","}"],"type":"codeListing"},{"level":3,"text":"Counterexamples","anchor":"Counterexamples","type":"heading"},{"inlineContent":[{"text":"When a value causes a property to fail, SwiftTestKit will shrink the value to","type":"text"},{"text":" ","type":"text"},{"text":"the smallest value that still fails the property (the minimal counterexample).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"SwiftTestKit assertions are automatically intercepted inside property bodies,","type":"text"},{"text":" ","type":"text"},{"text":"so counterexamples include the same diff output, expression capture, and","type":"text"},{"text":" ","type":"text"},{"text":"formatting used by standalone assertions.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The counterexample is reported along with the seed used for generation. To","type":"text"},{"text":" ","type":"text"},{"text":"deterministically reproduce the failure, set ","type":"text"},{"code":"PropertyOptions.seed","type":"codeVoice"},{"text":" or the","type":"text"},{"text":" ","type":"text"},{"code":"TEST_KIT_SEED","type":"codeVoice"},{"text":" environment variable. The failing values can also be pinned as","type":"text"},{"text":" ","type":"text"},{"text":"examples to prevent regressions.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func customSort(_ array: [Int]) -> [Int] { \/* ... *\/ }","","STKForAll","{","    (array: [Int]) in","    ","    \/\/ Assert that a custom sort function is working correctly.","    STKAssertSorted(customSort(array), by: >=)","}","","\/\/ STKForAll failed after 4 iterations (shrunk in 2 steps)","\/\/ ","\/\/ Counterexample:","\/\/     Array<Int> = [1, 0]","\/\/ ","\/\/ STKAssertSorted failed","\/\/ ","\/\/ Collection count: 2","\/\/ ","\/\/ Not sorted at:","\/\/ ","\/\/     [0]: 0","\/\/     [1]: 1","\/\/ ","\/\/ Seed: 2188239925673862914 (STKForAll)"],"type":"codeListing"},{"level":3,"type":"heading","text":"Generators","anchor":"Generators"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a "},{"type":"reference","identifier":"doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/Generator","isActive":true},{"text":" when ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/Arbitrary","isActive":true},{"text":" conformance of a specific type does not","type":"text"},{"type":"text","text":" "},{"text":"produce the necessary distribution of values. For example, a generator may be","type":"text"},{"type":"text","text":" "},{"text":"used to test only positive integers, or only non-empty arrays.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func customSort(_ array: [Int]) -> [Int] { \/* ... *\/ }","","STKForAll(using: .nonEmptyArray(of: Int.self))","{","    (array: [Int]) in","    ","    \/\/ Assert that a custom sort function is working correctly, ","    \/\/ but test with only non-empty arrays.","    STKAssertSorted(customSort(array), by: >=)","}"]},{"level":3,"anchor":"Classification","text":"Classification","type":"heading"},{"inlineContent":[{"type":"text","text":"Classification functions conditionally tag iterations with descriptive labels,"},{"text":" ","type":"text"},{"text":"tracking the distribution of generated values across categories. Minimum","type":"text"},{"text":" ","type":"text"},{"text":"coverage requirements can be set to fail the test with a distribution summary","type":"text"},{"text":" ","type":"text"},{"text":"if the requirement is not met.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["STKForAll(using: generator)","{","    (array: [Int]) in","    ","    \/\/ Discard empty arrays.","    try STKAssume(!array.isEmpty)","    ","    \/\/ 10% of arrays must have more than 5 elements.","    \/\/ Otherwise, the test fails.","    STKCover(10, \"large\", when: array.count > 5)","    ","    \/\/ Label single-element arrays.","    STKClassify(\"non-empty\", when: array.count == 1)","    ","    \/\/ Test properties that must hold for any non-empty array.","}"],"type":"codeListing"},{"inlineContent":[{"text":"Tables track the distribution of generated values along independent named","type":"text"},{"text":" ","type":"text"},{"text":"dimensions, with optional coverage requirements.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["STKForAll(using: generator)","{","    (n: Int) in","    ","    \/\/ Track the parity of generated integers.","    STKTabulate(\"parity\", n.isMultiple(of: 2) ? \"even\" : \"odd\")","    ","    \/\/ At least 50% of generated integers must be even.","    STKCoverTable(\"parity\", (50, \"even\"))","    ","    \/\/ Test properties that must hold for any integer.","}"],"type":"codeListing"},{"level":3,"text":"Targeted Testing","anchor":"Targeted-Testing","type":"heading"},{"inlineContent":[{"text":"Targeted property-based testing guides generation toward values that maximize","type":"text"},{"text":" ","type":"text"},{"text":"a numeric target. While standard property-based testing generates a new value","type":"text"},{"text":" ","type":"text"},{"text":"on each iteration, targeted testing maintains a pool of high-target values","type":"text"},{"text":" ","type":"text"},{"text":"and either generates a new value (exploration) or selects and mutates a pooled","type":"text"},{"text":" ","type":"text"},{"text":"value (exploitation) on each iteration.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Over many iterations, the targeting process converges toward values that","type":"text"},{"text":" ","type":"text"},{"text":"maximize the target metric, testing edge cases and worst-case behavior that","type":"text"},{"text":" ","type":"text"},{"text":"random generation alone is unlikely to reach.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func partition(_ array: [Int]) -> (left: [Int], right: [Int]) { \/* ... *\/ }","","STKForAll(using: .nonEmptyArray(of: Int.self))","{","    (array: [Int]) in","    ","    let (left, right) = partition(array)","    ","    let imbalance: Int = abs(left.reduce(0, +) - right.reduce(0, +))","    ","    \/\/ Guide generation toward arrays that maximize the partition imbalance.","    STKTarget(Double(imbalance))","    ","    \/\/ Test properties that must hold for any partition.","    STKAssertEqual(left.count + right.count, array.count)","}"],"type":"codeListing"},{"level":3,"text":"Built-In Conformance","anchor":"Built-In-Conformance","type":"heading"},{"inlineContent":[{"text":"Built-in ","type":"text"},{"identifier":"doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/Arbitrary","isActive":true,"type":"reference"},{"text":" conformance is provided for many standard library types:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All integers ("},{"type":"codeVoice","code":"Int"},{"type":"text","text":", "},{"type":"codeVoice","code":"Int8"},{"type":"text","text":" through "},{"type":"codeVoice","code":"Int64"},{"type":"text","text":", "},{"type":"codeVoice","code":"UInt"},{"type":"text","text":", "},{"type":"codeVoice","code":"UInt8"},{"type":"text","text":" through"},{"type":"text","text":" "},{"type":"codeVoice","code":"UInt64"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Floating-point numbers ("},{"type":"codeVoice","code":"Float"},{"type":"text","text":", "},{"type":"codeVoice","code":"Float16"},{"type":"text","text":", "},{"type":"codeVoice","code":"Double"},{"type":"text","text":", "},{"type":"codeVoice","code":"Decimal"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Collections ("},{"type":"codeVoice","code":"Array"},{"type":"text","text":", "},{"type":"codeVoice","code":"Set"},{"type":"text","text":", "},{"type":"codeVoice","code":"Dictionary"},{"type":"text","text":", "},{"type":"codeVoice","code":"CollectionOfOne"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ranges ("},{"type":"codeVoice","code":"Range"},{"type":"text","text":", "},{"type":"codeVoice","code":"ClosedRange"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Foundation types ("},{"type":"codeVoice","code":"Date"},{"type":"text","text":", "},{"type":"codeVoice","code":"Data"},{"type":"text","text":", "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"},{"type":"text","text":", "},{"type":"codeVoice","code":"Substring"},{"type":"text","text":", "},{"type":"codeVoice","code":"Character"},{"type":"text","text":", "},{"type":"codeVoice","code":"Unicode.Scalar"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Bool"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Optional"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Result"}]}]}],"type":"unorderedList"},{"level":3,"text":"Custom Type Conformance","anchor":"Custom-Type-Conformance","type":"heading"},{"inlineContent":[{"text":"Apply the ","type":"text"},{"identifier":"doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/Arbitrary()","isActive":true,"type":"reference"},{"text":" macro to a struct or enum to automatically synthesize","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/Arbitrary","isActive":true,"type":"reference"},{"text":" conformance for custom types.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Generic parameters that appear in stored properties or associated values are","type":"text"},{"text":" ","type":"text"},{"text":"automatically constrained to ","type":"text"},{"identifier":"doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/Arbitrary","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@Arbitrary","struct User<T>: Equatable where T : Equatable & Hashable","{","    let name    : String","    let id      : T","}","","STKForAll","{","    (user: User<UUID>) in","    ","    \/\/ Test properties that must hold for any user.","}"],"type":"codeListing"},{"inlineContent":[{"text":"Recursive and ","type":"text"},{"code":"indirect","type":"codeVoice"},{"text":" enums are also supported.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@Arbitrary","indirect enum Tree: Equatable","{","    case leaf","    case node(Tree, Tree)","}","","STKForAll","{","    (a: Tree, b: Tree) in","    ","    \/\/ Test properties that must hold for any pair of trees.","}"],"type":"codeListing"},{"level":3,"text":"Stateful Testing","anchor":"Stateful-Testing","type":"heading"},{"inlineContent":[{"text":"Stateful testing extends property-based testing to systems with mutable state.","type":"text"},{"text":" ","type":"text"},{"text":"Rather than testing individual values against a property, stateful testing","type":"text"},{"text":" ","type":"text"},{"text":"generates random sequences of commands and executes them against both a","type":"text"},{"text":" ","type":"text"},{"text":"simplified model and the real system, verifying consistency at each step.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Commands conform to the ","type":"text"},{"identifier":"doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/Stateful","isActive":true,"type":"reference"},{"text":" protocol, which defines how to generate","type":"text"},{"text":" ","type":"text"},{"text":"random commands, execute them against the model and system, and advance the","type":"text"},{"text":" ","type":"text"},{"text":"model independently. Optional preconditions filter commands based on the model","type":"text"},{"text":" ","type":"text"},{"text":"state, and optional postconditions verify system behavior after each command","type":"text"},{"text":" ","type":"text"},{"text":"is executed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When a failing command sequence is found, it is shrunk to the minimal","type":"text"},{"text":" ","type":"text"},{"text":"counterexample in two phases: removal shrinking removes unnecessary commands,","type":"text"},{"text":" ","type":"text"},{"text":"and argument shrinking reduces individual command parameters.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ A stack with a subtle bug that is discovered by stateful testing.","struct Stack<T>","{","    private var storage: [T] = []","    ","    var count: Int","    {","        return storage.count","    }","    ","    mutating func push(","        _ element: T","    )","    {","        storage.append(element)","    }","    ","    mutating func pop() -> T","    {","        \/\/ Bug: This should be removeLast()","        return storage.removeFirst()","    }","}","","\/\/ Commands that test the Stack against a simple array model.","@Stateful","enum StackCommand","{","    \/\/ The system under test, and the model used to test it.","    typealias System    = Stack<Int>","    typealias Model     = [Int]","    ","    \/\/ The commands to use in randomly-generated command sequences.","    \/\/ Weighted so push is selected 3 times more often than pop and count.","    @Weight(3) case push(Int)","    @Weight(1) case pop","    @Weight(1) case count","    ","    \/\/ Generated by the @Stateful macro automatically:","    \/\/ - arbitrary(using:model:)","    \/\/ - shrink()","    ","    \/\/ Checks whether this command is valid under the given model state.","    func precondition(","        model: Model","    ) -> Bool","    {","        switch self","        {","            case .pop   : return !model.isEmpty","            default     : return true","        }","    }","    ","    \/\/ Executes the command on both the given model and system.","    func run(","        model   : inout Model,","        system  : inout System","    ) async","    {","        switch self","        {","            case .push(let value):","                ","                model.append(value)","                system.push(value)","                ","            case .pop:","                ","                let expected    : Int   = model.removeLast()","                let actual      : Int   = system.pop()","                ","                STKAssertEqual(expected, actual)","                ","            case .count:","                ","                STKAssertEqual(model.count, system.count)","        }","    }","    ","    \/\/ Advances to the next model state without executing against the system.","    func advance(","        model: inout Model","    )","    {","        switch self","        {","            case .push(let value)   : model.append(value)","            case .pop               : model.removeLast()","            case .count             : break","        }","    }","}","","await STKStateful(","    model:      { [] },","    system:     { Stack() },","    command:    StackCommand.self",")","","\/\/ STKStateful failed after 5 iterations (shrunk to 3 commands)","\/\/ ","\/\/ Counterexample:","\/\/     1. push(0)","\/\/     2. push(1)","\/\/     3. pop ←","\/\/ ","\/\/ STKAssertEqual failed","\/\/ ","\/\/ Expected:   1","\/\/ Actual:     0","\/\/ ","\/\/ Seed: 6549428853488321548 (STKStateful)"],"type":"codeListing"},{"level":2,"text":"Composition","anchor":"Composition","type":"heading"},{"inlineContent":[{"text":"Property-based tests, stateful tests, temporal tests, performance tests,","type":"text"},{"text":" ","type":"text"},{"text":"and atomic tests compose freely. Any evaluator may be nested inside any","type":"text"},{"text":" ","type":"text"},{"text":"other evaluator, and all evaluators can wrap standalone assertions. Any","type":"text"},{"text":" ","type":"text"},{"text":"failures propagate with the same rich output used by standalone assertions.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Assert that any random array is correctly sorted within 50 milliseconds.","await STKForAll","{","    (array: [Int]) in","    ","    await STKPerformance(timeLimit: .milliseconds(50))","    {","        STKAssertSorted(customSort(array), by: >=)","    }","}"],"type":"codeListing"},{"syntax":"swift","code":["let pipeline = Pipeline()","pipeline.start()","","\/\/ Assert that all stages are eventually ready at the same time.","await STKEventually(timeout: .seconds(5))","{","    STKAtomic","    {","        STKAssertEqual(.ready, pipeline.stage1)","        STKAssertEqual(.ready, pipeline.stage2)","        STKAssertEqual(.ready, pipeline.stage3)","    }","}"],"type":"codeListing"},{"syntax":"swift","code":["\/\/ Assert that any random number is eventually processed.","await STKForAll","{","    (n: Int) in","    ","    let processor = Processor(value: n)","    processor.start()","    ","    await STKEventually(timeout: .seconds(2))","    {","        STKAssertEqual(.completed, processor.state)","    }","}"],"type":"codeListing"},{"level":2,"text":"Installation","anchor":"Installation","type":"heading"},{"level":3,"text":"Swift Package Manager","anchor":"Swift-Package-Manager","type":"heading"},{"inlineContent":[{"text":"swift-test-kit may be installed using","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/docs.swift.org\/swiftpm\/documentation\/packagemanagerdocs\/","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The package includes both SwiftTestKit and XCTestKit.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Test with Swift Testing and SwiftTestKit.","import Testing","import SwiftTestKit","","\/\/ Test with XCTest and XCTestKit.","import XCTest","import XCTestKit"],"type":"codeListing"},{"inlineContent":[{"text":"See ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/xcode\/adding-package-dependencies-to-your-app","isActive":true,"type":"reference"},{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"for instructions on how to add package dependencies.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Requirements","anchor":"Requirements","type":"heading"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Platform"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Minimum Version"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Swift"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"6.3"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"iOS"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"18.0"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"iPadOS"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"18.0"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Mac Catalyst"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"18.0"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"macOS"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"15.0"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"tvOS"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"18.0"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"visionOS"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"2.0"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"watchOS"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"11.0"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"level":2,"text":"License","anchor":"License","type":"heading"},{"inlineContent":[{"text":"swift-test-kit is licensed under the Apache License, Version 2.0.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"See ","type":"text"},{"identifier":"https:\/\/github.com\/swift-developer-tools\/swift-test-kit\/blob\/main\/LICENSE.txt","isActive":true,"type":"reference"},{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"for the complete license terms.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"Composable property-based, stateful, performance, temporal, and atomic testing,","type":"text"},{"text":" ","type":"text"},{"text":"with structural diffs and advanced assertions for the Swift Testing framework.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit"},"references":{"doc://SwiftTestKit/documentation/SwiftTestKit/AtomicTesting":{"type":"topic","kind":"article","abstract":[{"text":"Group assertions into a single atomic evaluation.","type":"text"}],"identifier":"doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/AtomicTesting","role":"collectionGroup","url":"\/documentation\/swifttestkit\/atomictesting","title":"Atomic Testing"},"https://developer.apple.com/documentation/xctest":{"titleInlineContent":[{"text":"XCTest","type":"text"}],"type":"link","identifier":"https:\/\/developer.apple.com\/documentation\/xctest","title":"XCTest","url":"https:\/\/developer.apple.com\/documentation\/xctest"},"https://developer.apple.com/documentation/xcode/adding-package-dependencies-to-your-app":{"titleInlineContent":[{"text":"Xcode documentation","type":"text"}],"type":"link","identifier":"https:\/\/developer.apple.com\/documentation\/xcode\/adding-package-dependencies-to-your-app","title":"Xcode documentation","url":"https:\/\/developer.apple.com\/documentation\/xcode\/adding-package-dependencies-to-your-app"},"doc://SwiftTestKit/documentation/SwiftTestKit":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Composable property-based, stateful, performance, temporal, and atomic testing,"},{"type":"text","text":" "},{"text":"with structural diffs and advanced assertions for the Swift Testing framework.","type":"text"}],"identifier":"doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit","role":"collection","title":"SwiftTestKit","url":"\/documentation\/swifttestkit"},"doc://SwiftTestKit/documentation/SwiftTestKit/Arbitrary()":{"kind":"symbol","type":"topic","abstract":[{"text":"Synthesizes ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/Arbitrary","isActive":true},{"text":" conformance for structs and enums.","type":"text"}],"fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Arbitrary"},{"kind":"text","text":"()"}],"identifier":"doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/Arbitrary()","role":"symbol","title":"Arbitrary()","url":"\/documentation\/swifttestkit\/arbitrary()"},"doc://SwiftTestKit/documentation/SwiftTestKit/PropertyBasedTesting":{"type":"t