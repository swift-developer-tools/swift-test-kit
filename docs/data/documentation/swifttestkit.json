":"text","text":"and verify that median values stay within configurable limits."}],"role":"collectionGroup","title":"Performance Testing","url":"\/documentation\/swifttestkit\/performancetesting","type":"topic"},"https://developer.apple.com/xcode/swift-testing":{"titleInlineContent":[{"text":"Swift Testing","type":"text"}],"type":"link","identifier":"https:\/\/developer.apple.com\/xcode\/swift-testing","title":"Swift Testing","url":"https:\/\/developer.apple.com\/xcode\/swift-testing"},"doc://SwiftTestKit/documentation/SwiftTestKit/TemporalTesting":{"identifier":"doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/TemporalTesting","kind":"article","abstract":[{"type":"text","text":"Poll assertions over a configurable duration to verify continuous invariants"},{"type":"text","text":" "},{"text":"or eventual convergence.","type":"text"}],"role":"collectionGroup","url":"\/documentation\/swifttestkit\/temporaltesting","title":"Temporal Testing","type":"topic"},"doc://SwiftTestKit/documentation/SwiftTestKit/Stateful":{"kind":"symbol","type":"topic","url":"\/documentation\/swifttestkit\/stateful","title":"Stateful","role":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Stateful","kind":"identifier"}],"navigatorTitle":[{"text":"Stateful","kind":"identifier"}],"abstract":[{"type":"text","text":"A type that defines commands for stateful property-based testing."}],"identifier":"doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/Stateful"},"doc://SwiftTestKit/documentation/SwiftTestKit/CustomDiffs":{"type":"topic","kind":"article","abstract":[{"text":"Customize structural comparison and rendering when computing diffs.","type":"text"}],"identifier":"doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/CustomDiffs","role":"collectionGroup","url":"\/documentation\/swifttestkit\/customdiffs","title":"Custom Diffs"},"https://swift-developer-tools.github.io/swift-test-kit/documentation/xctestkit":{"titleInlineContent":[{"text":"XCTestKit","type":"text"}],"type":"link","identifier":"https:\/\/swift-developer-tools.github.io\/swift-test-kit\/documentation\/xctestkit","title":"XCTestKit","url":"https:\/\/swift-developer-tools.github.io\/swift-test-kit\/documentation\/xctestkit"},"doc://SwiftTestKit/documentation/SwiftTestKit/Generator":{"role":"symbol","identifier":"doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/Generator","type":"topic","title":"Generator","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Generator","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A custom generator for producing values of a specific type.","type":"text"}],"url":"\/documentation\/swifttestkit\/generator","navigatorTitle":[{"text":"Generator","kind":"identifier"}]},"doc://SwiftTestKit/documentation/SwiftTestKit/CustomDiffStringConvertible":{"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"CustomDiffStringConvertible"}],"abstract":[{"text":"A custom representation of a value for structural diffing.","type":"text"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"CustomDiffStringConvertible"}],"identifier":"doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/CustomDiffStringConvertible","role":"symbol","title":"CustomDiffStringConvertible","url":"\/documentation\/swifttestkit\/customdiffstringconvertible"},"doc://SwiftTestKit/documentation/SwiftTestKit/MacroAssertions":{"type":"topic","kind":"article","abstract":[{"text":"Assert that certain conditions are satisfied during code execution, and record","type":"text"},{"text":" ","type":"text"},{"text":"test failures with configurable diff output.","type":"text"}],"identifier":"doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/MacroAssertions","role":"collectionGroup","url":"\/documentation\/swifttestkit\/macroassertions","title":"Macro Assertions"},"doc://SwiftTestKit/documentation/SwiftTestKit/Configuration":{"identifier":"doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/Configuration","kind":"article","abstract":[{"type":"text","text":"Configurable testing options."}],"role":"collectionGroup","url":"\/documentation\/swifttestkit\/configuration","title":"Configuration","type":"topic"},"doc://SwiftTestKit/documentation/SwiftTestKit/Arbitrary":{"kind":"symbol","type":"topic","navigatorTitle":[{"text":"Arbitrary","kind":"identifier"}],"abstract":[{"text":"A type that can generate arbitrary random values.","type":"text"}],"fragments":[{"kind":"keyword","text":"typealias"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Arbitrary"}],"identifier":"doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/Arbitrary","role":"symbol","url":"\/documentation\/swifttestkit\/arbitrary","title":"Arbitrary"},"doc://SwiftTestKit/documentation/SwiftTestKit/CustomDiffRepresentable":{"identifier":"doc:\/\/SwiftTestKit\/documentation\/SwiftTestKit\/CustomDiffRepresentable","kind":"symbol","abstract":[{"text":"A type with a customized structural diff representation.","type":"text"}],"role":"symbol","title":"CustomDiffRepresentable","url":"\/documentation\/swifttestkit\/customdiffrepresentable","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"CustomDiffRepresentable"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"CustomDiffRepresentable"}]}}}