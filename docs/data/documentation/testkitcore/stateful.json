{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TestKitCore\/documentation\/TestKitCore\/Stateful"},"seeAlsoSections":[{"identifiers":["doc:\/\/TestKitCore\/documentation\/TestKitCore\/CommandStatistics"],"title":"Stateful Testing","generated":true,"anchor":"Stateful-Testing"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/TestKitCore\/documentation\/TestKitCore"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Stateful","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s8SendableP","text":"Sendable","kind":"typeIdentifier"}],"languages":["swift"]}]},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Types used with stateful property-based evaluators must conform to this","type":"text"},{"text":" ","type":"text"},{"text":"protocol.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Stateful testing validates a system under test by comparing its behavior","type":"text"},{"text":" ","type":"text"},{"text":"against a simplified model. Tests generate random sequences of commands,","type":"text"},{"text":" ","type":"text"},{"text":"execute them against both the model and system, and verify that the system","type":"text"},{"text":" ","type":"text"},{"text":"behaves consistently with the model.","type":"text"}],"type":"paragraph"},{"anchor":"Conformance","level":2,"text":"Conformance","type":"heading"},{"inlineContent":[{"text":"A stateful type must define:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/TestKitCore\/documentation\/TestKitCore\/Stateful\/System","isActive":true},{"type":"text","text":" under test and a simplified "},{"type":"reference","identifier":"doc:\/\/TestKitCore\/documentation\/TestKitCore\/Stateful\/Model","isActive":true},{"type":"text","text":" of its behavior."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"An ","type":"text"},{"type":"reference","identifier":"doc:\/\/TestKitCore\/documentation\/TestKitCore\/Stateful\/arbitrary(using:model:)","isActive":true},{"type":"text","text":" method to generate random commands."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/TestKitCore\/documentation\/TestKitCore\/Stateful\/run(model:system:)","isActive":true,"type":"reference"},{"type":"text","text":" method to execute the command on both the"},{"type":"text","text":" "},{"type":"text","text":"model and system."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"identifier":"doc:\/\/TestKitCore\/documentation\/TestKitCore\/Stateful\/advance(model:)","isActive":true,"type":"reference"},{"type":"text","text":" method to advance the model without side effects."}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"A stateful type may optionally define:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TestKitCore\/documentation\/TestKitCore\/Stateful\/precondition(model:)"},{"text":" method to determine whether a command is","type":"text"},{"text":" ","type":"text"},{"text":"valid for the model state. The default implementation always returns ","type":"text"},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TestKitCore\/documentation\/TestKitCore\/Stateful\/postcondition(model:system:)"},{"text":" method to determine whether the","type":"text"},{"text":" ","type":"text"},{"text":"system state is consistent with the model state after executing a command.","type":"text"},{"text":" ","type":"text"},{"text":"The default implementation always returns ","type":"text"},{"type":"codeVoice","code":"true"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TestKitCore\/documentation\/TestKitCore\/Stateful\/shrink()"},{"text":" method to enable model-independent argument shrinking.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The default implementation returns an empty array to indicate that no"},{"text":" ","type":"text"},{"type":"text","text":"shrinking should occur."}]}]},{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/TestKitCore\/documentation\/TestKitCore\/Stateful\/shrink(model:)","isActive":true,"type":"reference"},{"text":" method to enable model-dependent argument shrinking.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The default implementation delegates to the model-independent method."}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Below is an example of adding "},{"type":"reference","identifier":"doc:\/\/TestKitCore\/documentation\/TestKitCore\/Stateful","isActive":true},{"type":"text","text":" conformance to a custom type."}]},{"code":["enum CounterCommand: Stateful, CaseIterable","{","    case increment","    case decrement","    case reset","","    typealias System    = Counter","    typealias Model     = Int","","    static func arbitrary(","        using context   : GenerationContext,","        model           : Model","    ) -> CounterCommand","    {","        return context.randomElement(of: allCases)!","    }","","    func run(","        model   : inout Model,","        system  : inout System","    ) async throws","    {","        switch self","        {","            case .increment:","","                model += 1","                system.increment()","","            case .decrement:","","                model -= 1","                system.decrement()","","            case .reset:","","                model = 0","                system.reset()","        }","","        \/\/ Use SwiftTestKit or XCTestKit assertions as needed.","    }","","    func advance(","        model: inout Model","    )","    {","        switch self","        {","            case .increment : model += 1","            case .decrement : model -= 1","            case .reset     : model = 0","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/TestKitCore\/documentation\/TestKitCore\/Stateful\/run(model:system:)","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/TestKitCore\/documentation\/TestKitCore\/Stateful\/advance(model:)","isActive":true},{"type":"text","text":" must advance"},{"type":"text","text":" "},{"type":"text","text":"the model identically. If they diverge, shrinking may reject valid"},{"type":"text","text":" "},{"type":"text","text":"candidates or accept invalid candidates, producing counterexamples that"},{"type":"text","text":" "},{"type":"text","text":"do not reproduce the original failure."}]}],"type":"aside"},{"anchor":"Shrinking","level":2,"text":"Shrinking","type":"heading"},{"inlineContent":[{"text":"When a failing command sequence is found, it is automatically shrunk in","type":"text"},{"text":" ","type":"text"},{"text":"two phases:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Removal shrinking: Chunks of commands are removed from the sequence.","type":"text"},{"text":" ","type":"text"},{"text":"This step is always performed.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Argument shrinking: Individual commands are replaced by smaller","type":"text"},{"t