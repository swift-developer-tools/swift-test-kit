in\/LICENSE.txt","type":"link","titleInlineContent":[{"text":"LICENSE","type":"text"}]},"https://developer.apple.com/documentation/xcode/adding-package-dependencies-to-your-app":{"title":"Xcode documentation","identifier":"https:\/\/developer.apple.com\/documentation\/xcode\/adding-package-dependencies-to-your-app","url":"https:\/\/developer.apple.com\/documentation\/xcode\/adding-package-dependencies-to-your-app","type":"link","titleInlineContent":[{"text":"Xcode documentation","type":"text"}]},"doc://XCTestKit/documentation/XCTestKit/PropertyBasedTesting":{"kind":"article","abstract":[{"type":"text","text":"Automatically generate random test cases, shrink failures to minimal"},{"type":"text","text":" "},{"type":"text","text":"counterexamples, and report failing values with full assertion output."}],"title":"Property-Based Testing","url":"\/documentation\/xctestkit\/propertybasedtesting","identifier":"doc:\/\/XCTestKit\/documentation\/XCTestKit\/PropertyBasedTesting","role":"collectionGroup","type":"topic"},"doc://XCTestKit/documentation/XCTestKit/Generator":{"url":"\/documentation\/xctestkit\/generator","role":"symbol","type":"topic","title":"Generator","navigatorTitle":[{"text":"Generator","kind":"identifier"}],"abstract":[{"text":"A custom generator for producing values of a specific type.","type":"text"}],"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Generator","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/XCTestKit\/documentation\/XCTestKit\/Generator"},"doc://XCTestKit/documentation/XCTestKit":{"type":"topic","role":"collection","url":"\/documentation\/xctestkit","kind":"symbol","abstract":[{"text":"Composable property-based, stateful, performance, temporal, and atomic testing,","type":"text"},{"text":" ","type":"text"},{"text":"with structural diffs and advanced assertions for the XCTest framework.","type":"text"}],"title":"XCTestKit","identifier":"doc:\/\/XCTestKit\/documentation\/XCTestKit"},"doc://XCTestKit/documentation/XCTestKit/CustomDiffRepresentable":{"kind":"symbol","abstract":[{"type":"text","text":"A type with a customized structural diff representation."}],"title":"CustomDiffRepresentable","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"CustomDiffRepresentable"}],"url":"\/documentation\/xctestkit\/customdiffrepresentable","identifier":"doc:\/\/XCTestKit\/documentation\/XCTestKit\/CustomDiffRepresentable","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CustomDiffRepresentable"}],"type":"topic"},"doc://XCTestKit/documentation/XCTestKit/TemporalTesting":{"type":"topic","role":"collectionGroup","url":"\/documentation\/xctestkit\/temporaltesting","abstract":[{"type":"text","text":"Poll assertions over a configurable duration to verify continuous invariants"},{"type":"text","text":" "},{"type":"text","text":"or eventual convergence."}],"kind":"article","title":"Temporal Testing","identifier":"doc:\/\/XCTestKit\/documentation\/XCTestKit\/TemporalTesting"},"doc://XCTestKit/documentation/XCTestKit/FunctionAssertions":{"type":"topic","role":"collectionGroup","url":"\/documentation\/xctestkit\/functionassertions","abstract":[{"type":"text","text":"Assert that certain conditions are satisfied during code execution, and record"},{"type":"text","text":" "},{"type":"text","text":"test failures with configurable diff output."}],"kind":"article","title":"Function Assertions","identifier":"doc:\/\/XCTestKit\/documentation\/XCTestKit\/FunctionAssertions"},"https://developer.apple.com/documentation/xctest":{"title":"XCTest","identifier":"https:\/\/developer.apple.com\/documentation\/xctest","url":"https:\/\/developer.apple.com\/documentation\/xctest","type":"link","titleInlineContent":[{"text":"XCTest","type":"text"}]},"doc://XCTestKit/documentation/XCTestKit/Arbitrary":{"url":"\/documentation\/xctestkit\/arbitrary","role":"symbol","type":"topic","title":"Arbitrary","navigatorTitle":[{"text":"Arbitrary","kind":"identifier"}],"abstract":[{"text":"A type that can generate arbitrary random values.","type":"text"}],"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arbitrary","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/XCTestKit\/documentation\/XCTestKit\/Arbitrary"},"doc://XCTestKit/documentation/XCTestKit/PerformanceTesting":{"kind":"article","abstract":[{"type":"text","text":"Measure execution time and physical memory footprint across multiple runs,"},{"type":"text","text":" "},{"type":"text","text":"and verify that median values stay within configurable limits."}],"title":"Performance Testing","url":"\/documentation\/xctestkit\/performancetesting","identifier":"doc:\/\/XCTestKit\/documentation\/XCTestKit\/PerformanceTesting","role":"collectionGroup","type":"topic"},"https://developer.apple.com/xcode/swift-testing":{"type":"link","title":"Swift Testing","titleInlineContent":[{"text":"Swift Testing","type":"text"}],"url":"https:\/\/developer.apple.com\/xcode\/swift-testing","identifier":"https:\/\/developer.apple.com\/xcode\/swift-testing"}}}